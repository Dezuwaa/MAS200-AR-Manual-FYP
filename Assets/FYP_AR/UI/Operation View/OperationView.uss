.root-container {
    flex-grow: 1;
    justify-content: space-between;
    margin-top: 15px;
    margin-right: 15px;
    margin-bottom: 15px;
    margin-left: 15px;
}

.center-container {
    flex-grow: 12;
}

.operation-box {
    background-color: rgba(30, 30, 30, 0.95);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    padding: 20px;
    border-top-width: 2px;
    border-color: rgb(74, 74, 74);
    align-items: stretch;
    flex-grow: 1;
}

.mode-toggle-container {
    align-items: flex-end;
    margin-bottom: 10px;
}

.mode-toggle-btn {
    background-color: rgb(42, 42, 42);
    color: rgb(245, 245, 245);
    border-width: 1px;
    border-color: rgb(85, 85, 85);
    border-radius: 6px;
    padding: 8px 12px;
    font-size: 20px;
    transition-duration: 0.2s;
}

.mode-toggle-btn:hover {
    background-color: rgb(58, 58, 58);
}

.step-header-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 15px;
}

.step-text {
    color: rgb(245, 245, 245);
    font-size: 20px;
    -unity-font-style: bold;
    margin: 0 5px;
}

.step-input-field {
    width: 50px;
    margin: 0;
}

.step-input-field > .unity-text-field__input {
    background-color: rgb(51, 51, 51);
    color: rgb(245, 245, 245);
    border-width: 1px;
    border-color: rgb(85, 85, 85);
    border-radius: 6px;
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding: 4px;
}

.step-input-field > .unity-text-field__input:focus {
    border-color: rgb(245, 245, 245);
}

.instruction-text {
    color: rgb(211, 211, 211);
    font-size: 24px;
    white-space: normal;
    -unity-text-align: upper-center;
    min-height: 80px;
    margin-bottom: 20px;
    flex-grow: 1;
}

.navigation-container {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
}

.nav-btn {
    flex-grow: 1;
    margin: 0 5px;
    background-color: rgb(42, 42, 42);
    color: rgb(245, 245, 245);
    border-width: 1px;
    border-color: rgb(85, 85, 85);
    border-radius: 8px;
    padding: 12px;
    font-size: 20px;
    -unity-font-style: bold;
    transition-duration: 0.2s;
}

.nav-btn:hover {
    background-color: rgb(74, 74, 74);
}

.nav-btn:active {
    background-color: rgb(26, 26, 26);
}

.op-top-bar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
}

.op-mode-title {
    color: rgb(245, 245, 245);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    flex-grow: 1;
    margin-left: 10px;
}
