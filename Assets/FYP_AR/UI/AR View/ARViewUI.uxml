<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/FYP_AR/UI/AR%20View/ARViewUI.uss?fileID=7433441132597879392&amp;guid=8cdba0cdb44e7a84fa053bcef55941b7&amp;type=3#ARViewUI"/>
    <Style src="project://database/Assets/FYP_AR/UI/GlobalStyle.uss?fileID=7433441132597879392&amp;guid=fce3a2d49f82bb44598cbf967edb6bb6&amp;type=3#GlobalStyle"/>
    <ui:VisualElement name="root" class="ar-root" style="height: 100%; overflow: visible;">
        <ui:VisualElement name="scaleContainer">

            <!-- Top Bar -->
            <ui:VisualElement name="topBar" class="ar-top-bar" style="flex-grow: 0; margin: 2%; flex-direction: row; justify-content: space-between;">
                <ui:Button text="⏎" name="backButton" class="ar-btn top-btn"/>
                <ui:Label text="MAS200 Base Supply" name="machineName" class="ar-machine-name"/>
                <ui:Button text="?" name="helpButton" class="ar-btn top-btn"/>
            </ui:VisualElement>

            <!-- Help Panel — hidden by default, sits just below top bar -->
            <ui:VisualElement name="helpPanel" class="ar-detail-panel" style="display: none;">
                <!-- Help Panel Top Bar -->
                <ui:VisualElement name="helpPanelTopBar" class="ar-panel-top-bar">
                    <ui:Label text="Help &amp; Controls" class="ar-panel-title"/>
                    <ui:Button text="✕" name="helpCloseButton" class="ar-panel-btn"/>
                </ui:VisualElement>
                <!-- Help Content -->
                <ui:VisualElement name="helpContent" class="ar-help-content">
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="⏎" class="ar-help-icon"/>
                        <ui:Label text="Back — Returns to the previous screen." class="ar-help-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="?" class="ar-help-icon"/>
                        <ui:Label text="Help — Toggles this help panel." class="ar-help-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="Op Man" class="ar-help-icon"/>
                        <ui:Label text="Operation Manual — Opens the step-by-step operation guide." class="ar-help-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="Detail" class="ar-help-icon"/>
                        <ui:Label text="Component Detail — Opens the component list panel. Tap a component to view its details." class="ar-help-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="Label" class="ar-help-icon"/>
                        <ui:Label text="Toggle Label — Shows or hides the name labels on 3D components." class="ar-help-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="⬡" class="ar-help-icon"/>
                        <ui:Label text="Toggle Overlay — Shows or hides the 3D component overlays." class="ar-help-description"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-help-row">
                        <ui:Label text="👆" class="ar-help-icon"/>
                        <ui:Label text="Tap a component — Selects it and displays its details in the panel." class="ar-help-description"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Center grows to fill space -->
            <ui:VisualElement name="centerContainer" class="ar-center"/>

            <!-- Bottom Wrapper -->
            <ui:VisualElement name="bottomWrapper" class="ar-bottom-wrapper">
                <ui:VisualElement name="bottomContainer" class="ar-bottom-container">
                    <ui:VisualElement class="ar-side-btns ar-left-btns">
                        <ui:Button text="Op&#10;Man" name="operationManual" class="ar-btn"/>
                        <ui:Button text="Detail" name="componentDetail" class="ar-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement class="ar-side-btns ar-right-btns">
                        <ui:Button text="PDF" name="pdfButton" class="ar-btn"/>
                        <ui:Button text="Label" name="toggleLabel" class="ar-btn"/>
                        <ui:Button text="" name="toggleOverlay" class="ar-btn overlay-btn">
                            <ui:VisualElement name="overlayIcon" class="ar-overlay-icon" style="background-image: url(&quot;project://database/Assets/FYP_AR/UI/UI%20Assets/cube_icon.png?fileID=2800000&amp;guid=6c246b7a710f1c24fbc0ef857ad0ef7a&amp;type=3#cube_icon&quot;);"/>
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="componentDetailPanel" class="ar-detail-panel" style="display: none;">
                    <ui:VisualElement name="panelTopBar" class="ar-panel-top-bar" style="padding-top: 6px; padding-bottom: 6px;">
                        <ui:Button text="☰" name="panelListButton" class="ar-panel-btn"/>
                        <ui:Label text="Component Name" name="panelTitle" class="ar-panel-title"/>
                        <ui:Button text="✕" name="panelCloseButton" class="ar-panel-btn"/>
                    </ui:VisualElement>
                    <ui:VisualElement name="panelContent" class="ar-panel-content">
                        <ui:ScrollView name="componentDetailScroll" class="ar-panel-scroll" style="display: none;">
                            <ui:VisualElement name="componentDetailContainer" class="ar-detail-container">
                                <ui:Label text="Select a component to view details." name="componentDetailText" class="ar-detail-text"/>
                            </ui:VisualElement>
                        </ui:ScrollView>
                        <ui:ScrollView name="componentListScroll" class="ar-panel-scroll" style="display: flex;">
                            <ui:VisualElement name="componentListContainer" class="ar-list-container">
                                <ui:Button name="componentButtonTemplate" text="Template" class="ar-list-item" style="display: none;"/>
                            </ui:VisualElement>
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>