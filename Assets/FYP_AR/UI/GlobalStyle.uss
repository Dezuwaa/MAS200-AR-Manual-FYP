Label {
    font-size: 30px;
}

Button {
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 100%;
}

#topBar {
    height: auto;
    max-height: 5%;
    flex-direction: row;
    align-items: center;
    flex-grow: 0;
}

#backButton {
    min-width: 5%;
    aspect-ratio: 1;
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 100%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(255, 255, 255);
    flex-shrink: 0;
    -unity-font-style: normal;
    font-size: 20px;
    -unity-text-align: middle-center;
}

#machineName {
    flex-grow: 1;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    font-size: 40px;
}

#helpButton {
    min-width: 5%;
    aspect-ratio: 1;
    border-top-left-radius: 100%;
    border-top-right-radius: 100%;
    border-bottom-right-radius: 100%;
    border-bottom-left-radius: 100%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgb(255, 255, 255);
    flex-shrink: 0;
    font-size: 20px;
    -unity-text-align: middle-center;
}






